# Optional: OpenRouter API key enables the LLM-powered interviewer, follow-ups,
# answer evaluation, and reports. Without a key the app runs fully offline using
# the built-in rule-based engine.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for interviews/feedback (any model served by OpenRouter).
# Free option: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# HTTP port for the local server
PORT=3000
